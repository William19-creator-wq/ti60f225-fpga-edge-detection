        <efx:timing_model name="I3" />
    </efx:device_info>
    <efx:design_info def_veri_version="sv_09" def_vhdl_version="vhdl_2008" unified_flow="false">
        <efx:top_module name="r1_algorithm_top" />
        <efx:design_file name="../rtl/frontend/line_store_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/frontend/rgb_to_y_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/frontend/window3x3_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/frontend/median9_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/frontend/sobel_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/frontend/frontend_frame_pair.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/reset_sync.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/pattern_pair_source.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/r1_job_supervisor.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/result_crc_observer.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/r1_led_status.sv" version="default" library="default" />
        <efx:design_file name="../rtl/r1/r1_algorithm_top.sv" version="default" library="default" />
        <efx:top_vhdl_arch name="" />
    </efx:design_info>
    <efx:interface_info>
        <efx:default_peri_file name="r1_algorithm.peri.xml" />
        <efx:peri_file name="r1_algorithm.peri.xml" />
    </efx:interface_info>
    <efx:constraint_info>
        <efx:sdc_file name="r1_algorithm.sdc" />
    </efx:constraint_info>
    <efx:sim_info />
    <efx:misc_info />
    <efx:ooc_info />
    <efx:ip_info />
    <efx:synthesis tool_name="efx_map">
        <efx:param name="work_dir" value="work_syn" value_type="e_string" />
        <efx:param name="write_efx_verilog" value="on" value_type="e_bool" />
        <efx:param name="mode" value="speed" value_type="e_option" />
        <efx:param name="retiming" value="0" value_type="e_option" />
        <efx:param name="seq_opt" value="0" value_type="e_option" />
        <efx:param name="blackbox-error" value="1" value_type="e_option" />
        <efx:param name="suppress_info_msgs" value="off" value_type="e_bool" />
        <efx:param name="suppress_warning_msgs" value="off" value_type="e_bool" />
    </efx:synthesis>
    <efx:place_and_route tool_name="efx_pnr">
        <efx:param name="work_dir" value="work_pnr" value_type="e_string" />
        <efx:param name="optimization_level" value="TIMING_3" value_type="e_option" />
        <efx:param name="seed" value="0" value_type="e_integer" />
        <efx:param name="suppress_info_msgs" value="off" value_type="e_bool" />
        <efx:param name="suppress_warning_msgs" value="off" value_type="e_bool" />
    </efx:place_and_route>
    <efx:bitstream_generation tool_name="efx_pgm">
        <efx:param name="mode" value="active" value_type="e_option" />
        <efx:param name="width" value="1" value_type="e_option" />
        <efx:param name="generate_bit" value="on" value_type="e_bool" />
        <efx:param name="generate_hex" value="on" value_type="e_bool" />
    </efx:bitstream_generation>
    <efx:debugger>
        <efx:param name="auto_instantiation" value="off" value_type="e_bool" />
        <efx:param name="profile" value="NONE" value_type="e_string" />
    </efx:debugger>
</efx:project>