User command: foreach transition $transitions {
 set name [lindex $transition 0]
 set starts [get_pins -regexp [lindex $transition 1]]
 set ends [get_pins -regexp [lindex $transition 2]]
 puts "DATA_${name}_SOURCE_COUNT=[llength $starts]"
 puts "DATA_${name}_DEST_COUNT=[llength $ends]"
 if {[llength $starts]==0 || [llength $ends]==0} {error "Data endpoint collection empty"}
 report_timing -setup -from $starts -to $ends -npaths 8 -nworst 1 -file scalar_${name}_setup.rpt
 report_timing -hold -from $starts -to $ends -npaths 8 -nworst 1 -file scalar_${name}_hold.rpt
}

