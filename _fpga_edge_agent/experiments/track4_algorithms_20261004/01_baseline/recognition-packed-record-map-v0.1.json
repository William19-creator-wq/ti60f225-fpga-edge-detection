  "packing": {
    "canonical_bit_order": "Record low bit first; table item0 first; byte low bit first. Preserve R4 layout3/numeric1/algorithm3 logical fields and reserved-zero checks.",
    "record_start_bit": "item_index * record_bits (wide checked arithmetic)",
    "record_end_bit_exclusive": "record_start_bit + record_bits",
    "logical_byte_address": "descriptor.base + floor(record_start_bit / 8)",
    "first_bit_in_byte": "record_start_bit mod 8",
    "logical_byte_length": "ceil((first_bit_in_byte + record_bits) / 8)",
    "aligned_span_start": "descriptor.base + 16 * floor(record_start_bit / 128)",
    "aligned_span_length_bytes": "16 * ceil(((record_start_bit mod 128) + record_bits) / 128)",
    "authority": "All actual identities, stage/gen/revision, ref/version/grant, initialized ranges, prefix and mutable exclusive/latest protections require real providers. This JSON grants none.",
    "padding": "Canonical record zero fields remain checked. Table high tail bits and rounded physical bytes must be initialized to zero by a separately authorized path; guard and unassigned slot bytes are never ordinary data.",
    "bounds": "0 <= item_index < real admitted valid_count or capacity as permitted by the specific operation. EDGE/GRAD/ANN require full-frame coverage where relevant; no reading uninitialized POINT or private prefix."
  },
