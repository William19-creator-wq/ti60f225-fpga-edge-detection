# V4 initial board: DDR pad reference delays come from current Efinity peripheral generation.
create_clock -period 40.000000 -name CLK_25M [get_ports {CLK_25M}]
create_clock -period 37.037037 -name CLK_27M [get_ports {CLK_27M}]
create_clock -period 2.500000 -name tx_cal_clk_90edge [get_ports {tx_cal_clk_90edge}]
create_clock -period 2.500000 -name sdram_clk [get_ports {sdram_clk}]
create_clock -period 2.500000 -name rx_cal_clk [get_ports {rx_cal_clk}]
create_clock -period 2.500000 -name tx_cal_clk [get_ports {tx_cal_clk}]
create_clock -period 10.000000 -name clk_100m [get_ports {clk_100m}]
create_clock -period 11.111111 -name core_clk [get_ports {core_clk}]
create_clock -period 13.468013 -name vid_clk_dvi2 [get_ports {vid_clk_dvi2}]
create_clock -period 6.734007 -name hdmi_tx_slow_clk [get_ports {hdmi_tx_slow_clk}]
create_clock -period 1.346801 -name hdmi_tx_fast_clk [get_ports {hdmi_tx_fast_clk}]
create_clock -period 18.518519 -name fb [get_ports {fb}]
create_clock -period 20.000000 -name i_mipi_rx_pclk [get_ports {i_mipi_rx_pclk}]
create_clock -period 200.000000 -name CLK_5M [get_ports {CLK_5M}]
create_clock -period 10.000000 -name i_cam_ck_CLKOUT [get_ports {i_cam_ck_CLKOUT}]
create_clock -period 8.888889 -name i_mipi_tx_pclk [get_ports {i_mipi_tx_pclk}]
create_clock -period 2.222222 -name i_mipi_txc_sclk [get_ports {i_mipi_txc_sclk}]
create_clock -period 2.222222 -name i_mipi_txd_sclk [get_ports {i_mipi_txd_sclk}]
set_clock_groups -asynchronous -group {core_clk i_mipi_tx_pclk i_mipi_txc_sclk i_mipi_txd_sclk} -group {clk_100m sdram_clk rx_cal_clk tx_cal_clk tx_cal_clk_90edge} -group {vid_clk_dvi2 hdmi_tx_slow_clk hdmi_tx_fast_clk fb} -group {i_mipi_rx_pclk CLK_5M} -group {i_cam_ck_CLKOUT} -group {CLK_25M CLK_27M}
set_false_path -from [get_ports {i_arstn key_inc_n key_dec_n key_mode_n}]
set_input_delay -clock CLK_5M -max 100 [get_ports {io_cam_sda_IN io_cam_scl_IN}]
set_input_delay -clock CLK_5M -min 0 [get_ports {io_cam_sda_IN io_cam_scl_IN}]
